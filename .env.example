# Copy this file to .env and fill in your values
# cp .env.example .env

# Flask
SECRET_KEY=change-this-to-a-random-string
FLASK_ENV=development

# JWT
JWT_SECRET_KEY=another-random-string-here

# Database
# SQLite (easiest for local dev — no setup needed):
DATABASE_URL=sqlite:///jobtrackr.db
# PostgreSQL (for production on Render):
# DATABASE_URL=postgresql://user:password@host:5432/jobtrackr

# AI — get free key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
